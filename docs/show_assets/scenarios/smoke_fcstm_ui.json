{
  "name": "smoke-fcstm-ui",
  "cwd": "/home/zhangshaoang/oo-projects/fcstm-ui",
  "shell": ["bash", "--noprofile", "--norc", "-i"],
  "requires": ["python3"],
  "ttyd": {
    "fontSize": 16,
    "typingDelayMs": 10,
    "cursorBlink": false,
    "viewport": { "width": 1500, "height": 980, "deviceScaleFactor": 2 },
    "theme": { "background": "#1a1b26" }
  },
  "screenshots": { "autocrop": true, "padding": 18 },
  "steps": [
    { "action": "command", "text": "export PS1='\\$ '", "clear_before": true, "wait_for_text": "\\$" },
    {
      "action": "command",
      "text": "QT_QPA_PLATFORM=offscreen FORCE_COLOR=1 venv37/bin/python main.py --smoke-test 2>&1 | tail -45",
      "clear_before": true,
      "wrap_at_columns": 150,
      "prompt_columns": 2,
      "typed_shot": "01-typed",
      "wait_for_text": "smoke test: PASSED",
      "timeout_ms": 120000
    },
    { "action": "sleep", "ms": 1500 },
    { "action": "screenshot", "name": "02-result" }
  ]
}
