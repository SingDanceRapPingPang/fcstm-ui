def float rmt = 0.0;
def float y = 0.0;
state StateMachine {
    state Idle;
    state Control {
        state B {
            enter abstract P1;
        }
        state C;
        state EState named 'E' {
            enter abstract P4;
            during abstract P3;
        }
        state A;
        state D {
            enter abstract P2;
        }
        [*] -> A;
        A -> B : if [y < 2200];
        D -> EState : /SIG5;
        B -> C : /SIG2;
        C -> D : if [rmt < 5000];
    }
    event SIG3 named 'Sig3';
    event SIG9 named 'Sig9';
    event SIG1 named 'Sig1';
    event SIG10 named 'Sig10';
    event SIG2 named 'Sig2';
    event SIG6 named 'Sig6';
    event SIG8 named 'Sig8';
    event SIG7 named 'Sig7';
    event SIG4 named 'Sig4';
    event SIG5 named 'Sig5';
    event SIG11 named 'Sig11';
    event SIG12 named 'Sig12';
    event SIG13 named 'Sig13';
    event SIG14 named 'Sig14';
    event SIG15 named 'Sig15';
    event SIG16 named 'Sig16';
    event SIG17 named 'Sig17';
    event SIG18 named 'Sig18';
    [*] -> Idle;
    Idle -> Control : /SIG1;
}