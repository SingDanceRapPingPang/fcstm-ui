def int x = 0;
def int y = 0;
state Root {
    state A;
    pseudo state C;
    state B {
        enter {
            x = 0;
        }
        state C1;
        state C2;
        pseudo state C3;

        [*] -> C1;
        C1 -> C2 : if [x >= 3];
        C1 -> C1 : if [y == 0] effect {
            x = x + 1;
        }
        C2 -> C3;
        C3 -> [*];
    }
    state D;

    [*] -> A;
    A -> B;
    C -> B;
    C -> D;
    B -> D;
    D -> [*];
}